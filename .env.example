# Copy this file to .env.local and fill it in. Never commit real secrets.
# Restart the dev server after changing it.

# --- Confirmation emails (Gmail API) -----------------------------------------
# Emails are sent through the Gmail API with the Google credentials further down (the same sign-in
# as the calendar). Enable the "Gmail API" in the same Google Cloud project, then run
# `npm run google:auth` (again, if you ran it before Gmail was added) so the token may send mail.
# The From address: the account that signed in, or one of its "Send mail as" aliases
# (Gmail > Settings > Accounts). Any other address is silently replaced by the account's own.
MAIL_FROM_EMAIL=
# The sender name people see in their inbox
MAIL_FROM_NAME=MS Dashboard
# Where replies go (defaults to MAIL_FROM_EMAIL)
MAIL_REPLY_TO=

# --- Optional -----------------------------------------------------------------
# Also email the iSN team about every new lead / booking
LEAD_NOTIFICATION_TO=
# Cc on the confirmation email the visitor receives (comma-separated; the visitor can see these addresses)
MAIL_CC=

# Fallback meeting link, used ONLY when Google Calendar (below) is not configured.
# Empty = every booking gets its own private Jitsi Meet room; or set one fixed Teams / Zoom / Meet link.
MEETING_URL=
# Length of the booked call in minutes (15-120)
MEETING_DURATION_MIN=30
# When the team takes calls, in Eastern Time (the booking pop-up always shows Eastern Time,
# EST in winter and EDT in summer). Times outside these hours cannot be picked.
MEETING_HOURS=09:00-18:00

# --- Google Calendar: books the slot as a calendar event with a Google Meet link ---------
# Leave all of this empty to skip it (bookings then use the fallback link above).
# Whose calendar receives the bookings: "primary" = the signed-in / impersonated account.
GOOGLE_CALENDAR_ID=primary

# Option A (any Google account): OAuth. Create a "Desktop app" OAuth client, fill in the two
# values, then run `npm run google:auth` once: it saves GOOGLE_REFRESH_TOKEN for you.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Option B (Google Workspace): service account with domain-wide delegation.
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY is the "private_key" from the JSON key, on ONE line, with the line breaks
# written as a backslash followed by the letter n.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_IMPERSONATE_USER=

# none (default) = the visitor only gets our own email (with an "Add to Google Calendar" link).
# all = Google also emails the visitor its own invitation, which is sent in the calendar owner's name.
GOOGLE_SEND_UPDATES=none
# Comma-separated team members added to every booking so it shows in their calendars
GOOGLE_EXTRA_ATTENDEES=
